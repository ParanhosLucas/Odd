# Porta HTTP
PORT=3000
# Tempo de cache por dia (segundos)
CACHE_TTL_SECONDS=30
# Por quanto tempo servir o último dado bom se o Flashscore falhar (segundos)
STALE_MAX_SECONDS=600
# Maior dia à frente que a API aceita (0 = hoje)
MAX_DAY=7
# Limite de requisições por IP por minuto em /api/odds
RATE_LIMIT_PER_MINUTE=120
# Use 1 atrás de proxy/balanceador (Render, Railway, Fly, nginx) para ler o IP em X-Forwarded-For
TRUST_PROXY=0
# 1 = usa dados de demonstração se não houver nada em cache; padrão: ligado fora de produção, desligado em produção
# DEMO_FALLBACK=0

# ---- Login e usuários ----
# Postgres onde ficam usuários e sessões (OBRIGATÓRIO em produção). Em produção usamos o Neon (grátis):
# cole a "Connection string" do projeto, no formato abaixo, em Environment no painel do Render.
# Local, sem esta variável, os usuários ficam só em memória (somem ao reiniciar).
# DATABASE_URL=postgresql://usuario:senha@ep-nome-123456-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Use 1 só se o banco exigir TLS e a URL não tiver sslmode (força TLS SEM verificar o certificado; evite)
# DATABASE_SSL=0
# Primeiro administrador: só é criado se o banco NÃO tiver nenhum administrador. Nunca sobrescreve senhas.
# ADMIN_USER=admin
# ADMIN_PASSWORD=troque-por-uma-senha-forte
# Segundos que a sessão fica em memória antes de conferir de novo no banco (evita uma ida ao banco por requisição)
# SESSION_CACHE_SECONDS=30
# Dias de validade do login
# SESSION_DAYS=7
# Cookie só por HTTPS (padrão: ligado em produção). Use 0 só para testar em http fora do localhost.
# COOKIE_SECURE=1

# ---- Backup automático do histórico ----
# Segundo Postgres (de preferência OUTRO projeto/conta do Neon) que recebe uma cópia do histórico a cada alteração.
# Deve ser diferente de DATABASE_URL. Sem esta variável não há cópia.
# BACKUP_DATABASE_URL=postgresql://usuario:senha@ep-outro-123456-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require
